# paperless-classify configuration
# Copy to .env and fill in, or export these before running the script.

# Paperless-ngx instance
PAPERLESS_URL=https://paperless.example.com
PAPERLESS_USER=admin
PAPERLESS_PASS=changeme

# Ollama inference
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Other tested models: gpt-oss:20b (slower, higher quality)
