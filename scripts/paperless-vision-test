#!/usr/bin/env python3
"""
paperless-vision-test — classify Paperless docs via Ollama vision model

Fetches the thumbnail for each doc ID, sends it to a local vision-capable
Ollama model, and returns structured JSON with suggested correspondent,
doc_type, and tags.

Usage:
  paperless-vision-test --ids 84,118,158
  paperless-vision-test --ids 84,118,158 --model gemma4:e4b
  paperless-vision-test --ids 84,118,158 --out results.json

Env vars (or .env):
  PAPERLESS_URL   https://paperless.example.com
  PAPERLESS_USER  admin
  PAPERLESS_PASS  changeme
  OLLAMA_URL      http://127.0.0.1:11434
  OLLAMA_MODEL    gemma4:e4b
"""

import argparse
import base64
import json
import os
import ssl
import sys
from urllib.request import Request, urlopen
from urllib.error import HTTPError

_SSL_CTX = ssl.create_default_context()
_SSL_CTX.check_hostname = False
_SSL_CTX.verify_mode = ssl.CERT_NONE

CANONICAL_DOCUMENT_TYPES = [
    "Bank Statement", "Correspondence", "Financial Report", "Government Form",
    "Insurance Document", "Investment Statement", "Invoice/Receipt",
    "Legal Agreement", "Meeting Document", "Other", "Personal Record",
    "Political Filing", "Property Record", "Tax Form",
]

CANONICAL_TAGS = [
    "federal", "hampton", "household", "income", "insurance", "legal",
    "medical", "personal", "property", "state", "tax", "union", "vehicle",
]


def load_env():
    env_path = os.path.join(os.path.dirname(__file__), "..", ".env")
    if os.path.exists(env_path):
        with open(env_path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, _, v = line.partition("=")
                    os.environ.setdefault(k.strip(), v.strip())

    return {
        "paperless_url": os.environ.get("PAPERLESS_URL", ""),
        "paperless_user": os.environ.get("PAPERLESS_USER", "admin"),
        "paperless_pass": os.environ.get("PAPERLESS_PASS", ""),
        "ollama_url": os.environ.get("OLLAMA_URL", "http://127.0.0.1:11434"),
        "ollama_model": os.environ.get("OLLAMA_MODEL", "gemma4:e4b"),
    }


def _auth_header(user, password):
    token = base64.b64encode(f"{user}:{password}".encode()).decode()
    return {"Authorization": f"Basic {token}"}


def fetch_thumbnail(cfg, doc_id):
    url = f"{cfg['paperless_url']}/api/documents/{doc_id}/thumb/"
    headers = _auth_header(cfg["paperless_user"], cfg["paperless_pass"])
    req = Request(url, headers=headers)
    with urlopen(req, context=_SSL_CTX, timeout=30) as resp:
        return base64.b64encode(resp.read()).decode()


def fetch_doc_meta(cfg, doc_id):
    url = f"{cfg['paperless_url']}/api/documents/{doc_id}/"
    headers = _auth_header(cfg["paperless_user"], cfg["paperless_pass"])
    req = Request(url, headers=headers)
    with urlopen(req, context=_SSL_CTX, timeout=15) as resp:
        return json.loads(resp.read())


def ollama_vision(cfg, image_b64, prompt):
    payload = json.dumps({
        "model": cfg["ollama_model"],
        "prompt": prompt,
        "images": [image_b64],
        "stream": False,
    }).encode()
    req = Request(
        f"{cfg['ollama_url']}/api/generate",
        data=payload,
        headers={"Content-Type": "application/json"},
    )
    with urlopen(req, timeout=120) as resp:
        result = json.loads(resp.read())
    return result.get("response", "").strip()


def build_prompt(doc_title, doc_types, tags):
    doc_types_str = ", ".join(doc_types)
    tags_str = ", ".join(tags)
    return f"""You are classifying a scanned document for a personal document management system.

Look at this document image carefully. Based on what you see, provide:
1. correspondent — the organization or person who sent/issued this document (e.g. "IRS", "Hampton City", "Navy Federal Credit Union"). Use the exact name visible in the document. If unclear, write "Unknown".
2. doc_type — pick the single best match from: {doc_types_str}
3. tags — pick 1-3 tags from: {tags_str}
4. confidence — one of: high, medium, low
5. notes — one short sentence explaining your reasoning

Document title (may be auto-generated/unhelpful): {doc_title}

Respond ONLY with a JSON object like:
{{"correspondent": "...", "doc_type": "...", "tags": ["..."], "confidence": "...", "notes": "..."}}"""


def parse_model_response(text):
    # Extract JSON from response — model may wrap it in markdown
    start = text.find("{")
    end = text.rfind("}") + 1
    if start == -1 or end == 0:
        return None
    try:
        return json.loads(text[start:end])
    except json.JSONDecodeError:
        return None


def classify_doc(cfg, doc_id):
    result = {"doc_id": doc_id, "error": None, "suggested": None}
    try:
        meta = fetch_doc_meta(cfg, doc_id)
        result["title"] = meta.get("title", "")
        result["original_correspondent"] = meta.get("correspondent")
        result["original_doc_type"] = meta.get("document_type")
        result["original_tags"] = meta.get("tags", [])

        image_b64 = fetch_thumbnail(cfg, doc_id)
        prompt = build_prompt(result["title"], CANONICAL_DOCUMENT_TYPES, CANONICAL_TAGS)
        raw = ollama_vision(cfg, image_b64, prompt)
        result["raw_response"] = raw

        parsed = parse_model_response(raw)
        if parsed:
            result["suggested"] = parsed
        else:
            result["error"] = "failed to parse model response"
    except HTTPError as e:
        result["error"] = f"HTTP {e.code}: {e.reason}"
    except Exception as e:
        result["error"] = str(e)
    return result


def main():
    load_env()
    cfg = load_env()

    parser = argparse.ArgumentParser(description="Vision-based Paperless doc classifier")
    parser.add_argument("--ids", required=True, help="Comma-separated doc IDs")
    parser.add_argument("--model", help="Override Ollama model")
    parser.add_argument("--out", help="Write results to this JSON file")
    args = parser.parse_args()

    if args.model:
        cfg["ollama_model"] = args.model

    if not cfg["paperless_url"]:
        print("ERROR: PAPERLESS_URL not set", file=sys.stderr)
        sys.exit(1)

    doc_ids = [int(x.strip()) for x in args.ids.split(",")]
    print(f"Classifying {len(doc_ids)} docs with {cfg['ollama_model']} ...", file=sys.stderr)

    results = []
    for i, doc_id in enumerate(doc_ids, 1):
        print(f"  [{i}/{len(doc_ids)}] doc {doc_id} ...", file=sys.stderr, end=" ", flush=True)
        r = classify_doc(cfg, doc_id)
        results.append(r)
        if r["error"]:
            print(f"ERROR: {r['error']}", file=sys.stderr)
        else:
            s = r.get("suggested", {})
            print(f"{s.get('correspondent','?')} | {s.get('doc_type','?')} | {s.get('confidence','?')}", file=sys.stderr)

    output = {
        "model": cfg["ollama_model"],
        "total": len(results),
        "errors": sum(1 for r in results if r["error"]),
        "results": results,
    }

    if args.out:
        with open(args.out, "w") as f:
            json.dump(output, f, indent=2)
        print(f"\nResults written to {args.out}", file=sys.stderr)
    else:
        print(json.dumps(output, indent=2))


if __name__ == "__main__":
    main()
