#!/usr/bin/env python3
"""
paperless-vision-classify — classify one Paperless doc via Ollama vision

Fetches the document thumbnail, sends it to a local vision-capable Ollama
model, and prints a single JSON object to stdout. Progress and errors go
to stderr. Designed to be called one doc at a time by n8n (throttling and
batching are n8n's job).

Usage:
  paperless-vision-classify --id 84
  paperless-vision-classify --id 84 --model gemma4:e4b
  paperless-vision-classify --id 84 --notify   # also POST result to OC hooks

Env vars (or .env adjacent to this script):
  PAPERLESS_URL     https://paperless.example.com
  PAPERLESS_USER    admin
  PAPERLESS_PASS    changeme
  OLLAMA_URL        http://127.0.0.1:11434
  OLLAMA_MODEL      gemma4:e4b
  OC_HOOKS_URL      http://127.0.0.1:18789/hooks/paperless
  OC_HOOKS_TOKEN    <token>

Exit codes:
  0  success — JSON result on stdout
  1  fatal error (missing config, Paperless unreachable, etc.)
"""

import argparse
import base64
import json
import os
import ssl
import sys
from urllib.error import HTTPError
from urllib.request import Request, urlopen

_SSL_CTX = ssl.create_default_context()
_SSL_CTX.check_hostname = False
_SSL_CTX.verify_mode = ssl.CERT_NONE

CANONICAL_DOCUMENT_TYPES = [
    "Bank Statement", "Correspondence", "Financial Report", "Government Form",
    "Insurance Document", "Investment Statement", "Invoice/Receipt",
    "Legal Agreement", "Meeting Document", "Other", "Personal Record",
    "Political Filing", "Property Record", "Tax Form",
]

CANONICAL_TAGS = [
    "federal", "hampton", "household", "income", "insurance", "legal",
    "medical", "personal", "property", "state", "tax", "union", "vehicle",
]


def load_env():
    env_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".env")
    if os.path.exists(env_path):
        with open(env_path) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, _, v = line.partition("=")
                    os.environ.setdefault(k.strip(), v.strip())
    return {
        "paperless_url": os.environ.get("PAPERLESS_URL", ""),
        "paperless_user": os.environ.get("PAPERLESS_USER", "admin"),
        "paperless_pass": os.environ.get("PAPERLESS_PASS", ""),
        "ollama_url": os.environ.get("OLLAMA_URL", "http://127.0.0.1:11434"),
        "ollama_model": os.environ.get("OLLAMA_MODEL", "gemma4:e4b"),
        "oc_hooks_url": os.environ.get("OC_HOOKS_URL", "http://127.0.0.1:18789/hooks/paperless"),
        "oc_hooks_token": os.environ.get("OC_HOOKS_TOKEN", ""),
    }


def _auth_header(user, password):
    token = base64.b64encode(f"{user}:{password}".encode()).decode()
    return {"Authorization": f"Basic {token}"}


def fetch_thumbnail(cfg, doc_id):
    url = f"{cfg['paperless_url']}/api/documents/{doc_id}/thumb/"
    req = Request(url, headers=_auth_header(cfg["paperless_user"], cfg["paperless_pass"]))
    with urlopen(req, context=_SSL_CTX, timeout=30) as resp:
        return base64.b64encode(resp.read()).decode()


def fetch_doc_meta(cfg, doc_id):
    url = f"{cfg['paperless_url']}/api/documents/{doc_id}/"
    req = Request(url, headers=_auth_header(cfg["paperless_user"], cfg["paperless_pass"]))
    with urlopen(req, context=_SSL_CTX, timeout=15) as resp:
        return json.loads(resp.read())


def ollama_vision(cfg, image_b64, prompt):
    payload = json.dumps({
        "model": cfg["ollama_model"],
        "prompt": prompt,
        "images": [image_b64],
        "stream": False,
    }).encode()
    req = Request(
        f"{cfg['ollama_url']}/api/generate",
        data=payload,
        headers={"Content-Type": "application/json"},
    )
    with urlopen(req, timeout=120) as resp:
        return json.loads(resp.read()).get("response", "").strip()


def build_prompt(doc_title):
    types_str = ", ".join(CANONICAL_DOCUMENT_TYPES)
    tags_str = ", ".join(CANONICAL_TAGS)
    return f"""You are classifying a scanned document for a personal document management system.

Look at this document image carefully and provide:
1. correspondent — the organization or person who issued this document (use the exact name visible). Write "Unknown" if unclear.
2. doc_type — pick the single best match from: {types_str}
3. tags — pick 1-3 from: {tags_str}
4. confidence — one of: high, medium, low
5. notes — one sentence explaining your reasoning

Document title (may be auto-generated): {doc_title}

Respond ONLY with a JSON object:
{{"correspondent": "...", "doc_type": "...", "tags": ["..."], "confidence": "...", "notes": "..."}}"""


def parse_response(text):
    start = text.find("{")
    end = text.rfind("}") + 1
    if start == -1 or end == 0:
        return None
    try:
        return json.loads(text[start:end])
    except json.JSONDecodeError:
        return None


def notify_hooks(cfg, text):
    """POST a plain-text notification to the OC hooks endpoint."""
    if not cfg.get("oc_hooks_token"):
        return
    payload = json.dumps({"text": text}).encode()
    req = Request(
        cfg["oc_hooks_url"],
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {cfg['oc_hooks_token']}",
        },
    )
    try:
        with urlopen(req, timeout=10) as resp:
            pass
    except Exception as e:
        print(f"hooks notify failed: {e}", file=sys.stderr)


def main():
    load_env()
    cfg = load_env()

    parser = argparse.ArgumentParser(description="Vision-based Paperless doc classifier")
    parser.add_argument("--id", required=True, type=int, dest="doc_id", help="Paperless document ID")
    parser.add_argument("--model", help="Override Ollama model")
    parser.add_argument("--notify", action="store_true", help="POST result to OC hooks endpoint")
    args = parser.parse_args()

    if args.model:
        cfg["ollama_model"] = args.model

    if not cfg["paperless_url"]:
        print("ERROR: PAPERLESS_URL not set", file=sys.stderr)
        sys.exit(1)

    doc_id = args.doc_id
    result = {"doc_id": doc_id, "error": None, "suggested": None}

    try:
        print(f"[paperless-vision-classify] doc {doc_id}: fetching metadata...", file=sys.stderr)
        meta = fetch_doc_meta(cfg, doc_id)
        result["title"] = meta.get("title", "")
        result["original_correspondent"] = meta.get("correspondent")
        result["original_doc_type"] = meta.get("document_type")
        result["original_tags"] = meta.get("tags", [])

        print(f"[paperless-vision-classify] doc {doc_id}: fetching thumbnail...", file=sys.stderr)
        image_b64 = fetch_thumbnail(cfg, doc_id)

        print(f"[paperless-vision-classify] doc {doc_id}: running {cfg['ollama_model']}...", file=sys.stderr)
        raw = ollama_vision(cfg, image_b64, build_prompt(result["title"]))
        result["raw_response"] = raw

        parsed = parse_response(raw)
        if parsed:
            result["suggested"] = parsed
            s = parsed
            print(
                f"[paperless-vision-classify] doc {doc_id}: {s.get('correspondent','?')} | "
                f"{s.get('doc_type','?')} | {s.get('confidence','?')}",
                file=sys.stderr,
            )
            if args.notify:
                notify_hooks(
                    cfg,
                    f"paperless doc {doc_id} classified: {s.get('correspondent','?')} · "
                    f"{s.get('doc_type','?')} · {s.get('confidence','?')} confidence\n"
                    f"_{s.get('notes','')}_",
                )
        else:
            result["error"] = "failed to parse model response"
            if args.notify:
                notify_hooks(cfg, f"paperless doc {doc_id}: model returned unparseable response")

    except HTTPError as e:
        result["error"] = f"HTTP {e.code}: {e.reason}"
        print(f"[paperless-vision-classify] ERROR: {result['error']}", file=sys.stderr)
        if args.notify:
            notify_hooks(cfg, f"paperless doc {doc_id} ERROR: {result['error']}")
        sys.exit(1)
    except Exception as e:
        result["error"] = str(e)
        print(f"[paperless-vision-classify] ERROR: {result['error']}", file=sys.stderr)
        if args.notify:
            notify_hooks(cfg, f"paperless doc {doc_id} ERROR: {result['error']}")
        sys.exit(1)

    print(json.dumps(result))


if __name__ == "__main__":
    main()
