    "tax information statement": "Tax Form",
    "utility bill": "Invoice/Receipt",
    "vehicle bill": "Property Record",
    "vehicle registration": "Government Form",
}

TAG_SYNONYMS = {
    "auto": "vehicle",
    "bank": "banking",
    "bank statement": "banking",
    "business expense": "business",
    "car": "vehicle",
    "city": "household",
