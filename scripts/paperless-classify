#!/usr/bin/env python3
"""
paperless-classify — local-model document classifier for Paperless-ngx

Subcommands:
  list                    List unclassified docs as JSON
  classify                Classify unclassified docs via Ollama (dry-run by default)
  apply < results.json    Apply a saved dry-run JSON to Paperless

Env vars (or ~/.config/paperless-classify.json):
  PAPERLESS_URL    https://paperless.example.com
  PAPERLESS_USER   admin
  PAPERLESS_PASS   changeme        (basic auth; ignored when PAPERLESS_TOKEN is set)
  PAPERLESS_TOKEN  <40-hex>        (DRF token auth; preferred — survives a password reset)
  OLLAMA_URL       http://127.0.0.1:11434
  OLLAMA_MODEL     gemma3:4b

Outputs clean JSON — safe to pipe to an n8n Execute Command node.
"""

import argparse
import base64
import json
import os
import re
import ssl
import subprocess
import sys
import tempfile
from urllib.error import HTTPError
from urllib.parse import urlencode
from urllib.request import Request, urlopen

# Local *.wade.internal services may use a private CA; do not fail on local TLS.
_SSL_CTX = ssl.create_default_context()
_SSL_CTX.check_hostname = False
_SSL_CTX.verify_mode = ssl.CERT_NONE

CANONICAL_DOCUMENT_TYPES = [
    "Bank Statement",
    "Correspondence",
    "Financial Report",
    "Government Form",
    "Insurance Document",
    "Investment Statement",
    "Invoice/Receipt",
    "Legal Agreement",
    "Meeting Document",
    "Other",
    "Personal Record",
    "Political Filing",
    "Property Record",
    "Tax Form",
    "Tax Return",
    "Union Document",
]

CANONICAL_TAGS = [
    "afge",
    "banking",
    "business",
    "crypto",
    "education",
    "household",
    "insurance",
    "investment",
    "legal",
    "medical",
    "personal",
    "political",
    "property",
    "retirement",
    "tax",
    "vehicle",
]

DOC_TYPE_SYNONYMS = {
    "bank statement": "Bank Statement",
    "bill": "Invoice/Receipt",
    "billing statement": "Invoice/Receipt",
    "city notice": "Correspondence",
    "delinquent tax notice": "Property Record",
